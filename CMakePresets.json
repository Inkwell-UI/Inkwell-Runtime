{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release plugin + tests (default Visual Studio generator, vcpkg x64-windows-static-md)",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      }
    },
    {
      "name": "tests",
      "displayName": "Core unit tests only (no CommonLibSSE-NG, fast)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build-tests",
      "cacheVariables": { "INKWELL_BUILD_PLUGIN": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "tests", "configurePreset": "tests", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "tests", "configurePreset": "tests", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
